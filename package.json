{
  "name": "conveypass",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && npm --prefix functions run typecheck",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:functions && npm run test:rules",
    "test:unit": "vitest run --project unit --project component",
    "test:functions": "firebase emulators:exec --only firestore --project demo-conveypass-functions \"npm --prefix functions test\"",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-conveypass-rules \"vitest run --project rules\"",
    "emulators": "firebase emulators:start --only auth,firestore,functions,storage",
    "seed:emulator": "tsx scripts/seed.ts --env emulator",
    "seed:prod": "tsx scripts/seed.ts --env prod",
    "seed:demo": "tsx scripts/seed-demo.ts --env emulator",
    "postinstall": "npm --prefix functions install",
    "config:csp": "tsx scripts/enforce-csp.ts",
    "create-tenant": "tsx scripts/create-tenant.ts",
    "reset-admin": "tsx scripts/reset-admin.ts",
    "admin:reset": "tsx scripts/reset-admin.ts",
    "superadmin:create": "tsx scripts/create-operator.ts",
    "superadmin:disable": "tsx scripts/disable-operator.ts",
    "superadmin:doctor": "tsx scripts/superadmin-doctor.ts",
    "dev:superadmin": "tsx scripts/dev-superadmin.ts --env emulator",
    "operator:create": "tsx scripts/create-operator.ts",
    "operator:disable": "tsx scripts/disable-operator.ts",
    "invite:create": "tsx scripts/invites.ts create",
    "invite:list": "tsx scripts/invites.ts list",
    "invite:revoke": "tsx scripts/invites.ts revoke",
    "verify:invite-access": "tsx scripts/verify-invite-access.ts --env emulator",
    "test:e2e": "firebase emulators:exec --only auth,firestore,functions,storage --project demo-conveypass-e2e \"npm --prefix functions run build && playwright test\"",
    "verify-restore": "tsx scripts/verify-restore.ts",
    "drill:restore": "tsx scripts/restore-drill.ts",
    "sla:check": "tsx functions/src/cli/runSlaCheck.ts",
    "bundle:report": "tsx scripts/bundle-report.ts",
    "contrast": "tsx scripts/check-contrast.ts",
    "build:e2e": "tsx scripts/build-e2e.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "firebase": "^12.19.0",
    "html5-qrcode": "^2.3.8",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.52.0",
    "papaparse": "^5.7.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fake-indexeddb": "^6.2.5",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.32.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-build": "^7.4.1"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
