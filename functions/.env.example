# Copy to functions/.env (local) or functions/.env.staging / functions/.env.prod (the file name is the alias in .firebaserc).
# Must match VITE_FUNCTIONS_REGION in the web app's .env
FUNCTIONS_REGION=asia-south1

# Public https origin of the web app. Used for the link inside push messages.
APP_BASE_URL=

# App Check enforcement for callables. Leave false until monitoring mode shows clean traffic (docs/ops.md).
ENFORCE_APP_CHECK=false

# Warm instances for checkIn, resolveVehicle and submitPass. 0 in staging, 1 in production (costs money, docs/ops.md).
MIN_INSTANCES=0

# Per-user rate limit for sensitive callables (calls per window).
RATE_LIMIT_CALLS=30
RATE_LIMIT_WINDOW_SECONDS=60
