# Firebase web app config (Firebase console > Project settings > Your apps). No real values committed.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Must match functions/.env FUNCTIONS_REGION
VITE_FUNCTIONS_REGION=asia-south1

# Set to "true" to talk to the local emulators (ports from firebase.json)
VITE_USE_EMULATORS=false

# Public origin that vehicle QR codes point to, e.g. https://convoypass.example.com (REQUIRED for QR screens).
# QR codes encode only ${VITE_APP_BASE_URL}/v/<vehicleId>. A localhost / non-production value shows a "Dev link: do not print" banner.
VITE_APP_BASE_URL=
# Optional: production hostname(s), comma separated. When set, any other host is treated as a dev link.
VITE_PRODUCTION_HOST=
